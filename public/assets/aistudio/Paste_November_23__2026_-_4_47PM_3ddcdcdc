      viewerEl.textContent = String(viewers);
    }, 4500);

    const POLICIES = {
      faqs: {
        title: 'Frequently Asked Questions',
        html: '<div class="space-y-4 text-sm text-zinc-700 leading-relaxed"><div><h4 class="font-bold text-black">How do I receive The Attraction Code?</h4><p>Immediately after confirming your order, you receive instant digital access to the complete three-phase training along with all three free bonuses ($63.00 value) on any phone, tablet, or computer.</p></div><div><h4 class="font-bold text-black">Is $7.97 a one-time payment?</h4><p>Yes. There are no recurring subscriptions or hidden fees. You pay $7.97 once and keep lifetime access to the program and bonuses.</p></div><div><h4 class="font-bold text-black">Does this work if I am naturally introverted or shy?</h4><p>Yes. The Attraction Code was built specifically so you never have to fake an outgoing persona or memorize pickup lines. It focuses on calm timing, warmth, and clear intent.</p></div></div>',
      },
      refund: {
        title: '365-Day Money-Back Guarantee Policy',
        html: '<div class="space-y-3 text-sm text-zinc-700 leading-relaxed"><p>Every copy of The Attraction Code is backed by a full 365-day satisfaction guarantee.</p><p>Take your time going through all three phases and the three included bonuses. If at any point within 365 days of purchase you feel the training has not improved your confidence or conversations, contact support with your order email for a prompt 100% refund of your $7.97.</p></div>',
      },
      privacy: {
        title: 'Privacy Policy',
        html: '<div class="space-y-3 text-sm text-zinc-700 leading-relaxed"><p>Your privacy and discretion are respected at every step. Your contact details are used solely to deliver your digital access and provide customer support.</p><p>We never sell, rent, or trade your email address or personal information with third parties. Billing statements remain discreet.</p></div>',
      },
      support: {
        title: 'Member Support',
        html: '<div class="space-y-3 text-sm text-zinc-700 leading-relaxed"><p>Have a question about accessing your program, downloading your three free bonuses, or requesting a refund under the 365-day guarantee?</p><p class="font-bold text-black bg-[#F4F4F5] inline-block px-2.5 py-1 rounded border border-zinc-300">Support Desk: support@attractioncodemethod.com</p><p>Support hours: Monday–Friday. Replies within 24 business hours.</p></div>',
      },
    };

    const policyModal = document.getElementById('policy-modal');
    const policyTitle = document.getElementById('policy-modal-title');
    const policyBody = document.getElementById('policy-modal-body');

    document.querySelectorAll('[data-policy]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = POLICIES[btn.getAttribute('data-policy')];
        if (!item) return;
        policyTitle.textContent = item.title;
        policyBody.innerHTML = item.html;
        policyModal.classList.remove('hidden');
        policyModal.classList.add('flex');
      });
    });

    function closePolicy() {
      policyModal.classList.add('hidden');
      policyModal.classList.remove('flex');
