    const productImageMaster = document.getElementById('product-image-master');
    document.querySelectorAll('[data-copy-product-src]').forEach((img) => {
      if (productImageMaster) img.src = productImageMaster.src;
    });

    const CHECKOUT_URL = 'https://pay.hotmart.com/Y108565530Y?checkoutMode=10';

    // META PIXEL: If your WordPress/GTM already installs the base pixel,
    // leave this blank to avoid loading it twice.
    // For a standalone HTML page without an existing pixel, enter your Pixel ID (digits only).
    const META_PIXEL_ID = '';

    // When a Pixel ID is supplied and no other Meta Pixel exists, load it once.
    // Nothing is loaded from Meta if the ID is blank and the page has no existing pixel.
    function initializeMetaPixelIfNeeded() {
      if (!/^\d{8,25}$/.test(META_PIXEL_ID)) return;
      if (typeof window.fbq === 'function') return;

      !function(f,b,e,v,n,t,s) {
        if (f.fbq) return;
        n = f.fbq = function(){ n.callMethod ?
          n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e); t.async = true; t.src = v;
        s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t,s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

      window.fbq('init', META_PIXEL_ID);
      window.fbq('track', 'PageView');
    }
    initializeMetaPixelIfNeeded();

    // Register checkout INTENT when the visitor clicks a buy button.
    // Do not fire Purchase here: the confirmed purchase belongs to Hotmart.
    function trackMetaCheckoutClick() {
      if (typeof window.fbq !== 'function') {
        console.warn('[Meta Pixel] Base pixel unavailable: install it through WordPress/GTM or fill META_PIXEL_ID in this HTML.');
        return false;
      }
      try {
        window.fbq('track', 'InitiateCheckout', {
          content_name: 'The Attraction Code',
          content_ids: ['Y108565530Y'],
          content_type: 'product',
          value: 7.97,
          currency: 'USD',
          num_items: 1
        });
        return true;
      } catch (error) {
        console.warn('[Meta Pixel] Failed to queue checkout event:', error);
        return false;
      }
    }

    let checkoutNavigationStarted = false;
    document.querySelectorAll('[data-checkout-link]').forEach((el) => {
      el.setAttribute('href', CHECKOUT_URL);
      el.addEventListener('click', (event) => {
        // A normal browser link remains usable even if the pixel is blocked.
        const queued = trackMetaCheckoutClick();
        if (!queued || event.defaultPrevented) return;
        // Preserve new-tab, middle-click, keyboard modifiers and download behavior.
        if (event.button !== 0 || event.ctrlKey || event.metaKey ||
            event.shiftKey || event.altKey || el.target === '_blank') return;
        event.preventDefault();
        if (checkoutNavigationStarted) return;
        checkoutNavigationStarted = true;
        // Brief delay improves the chance the browser transmits the pixel request.
        window.setTimeout(() => window.location.assign(el.href), 250);
      });
    });

    const now = new Date();
    document.getElementById('today-date').textContent = now.toLocaleDateString('en-US', {
